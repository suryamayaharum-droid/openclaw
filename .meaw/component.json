{
  "schema": "meaw.component/v1",
  "name": "openclaw",
  "repository": "suryamayaharum-droid/openclaw",
  "role": "edge-agent-runtime",
  "capabilities": [
    "agent-runtime",
    "gateway",
    "messaging",
    "multi-agent-routing",
    "skills",
    "tools"
  ],
  "interfaces": {
    "cli": "openclaw",
    "gateway_port_default": 18789
  },
  "memory": {
    "mode": "bridge",
    "backend": "workspace-memory",
    "authority": false
  },
  "health": [
    {"type": "command", "argv": ["openclaw", "doctor"]}
  ],
  "lifecycle": "active",
  "trust": "owned-fork",
  "priority": 80,
  "metadata": {
    "ecosystem": "MEAW",
    "integration": "runtime-bridge",
    "discovery_executes_commands": false
  }
}
